{
  "config": {
    "MD013": {
      "line_length": 88,
      "code_blocks": false,
      "tables": false,
    },
    "MD024": {
      "siblings_only": true,
    },
  },
  "ignores": [
    "node_modules/**",
    "dist/**",
    ".astro/**",
    ".lintro/**",
    "playwright-report/**",
    "coverage/**",
  ],
}
