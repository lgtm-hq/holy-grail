---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/home/HeroSection.astro';
import QuestSteps from '../components/home/QuestSteps.astro';
import CategoriesGrid from '../components/home/CategoriesGrid.astro';
import FeaturedGuides from '../components/home/FeaturedGuides.astro';
import CTASection from '../components/home/CTASection.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
const featuredGuides = allGuides.slice(0, 6);
---

<BaseLayout title="Holy Grail" description="The quest for the perfect dev environment - comprehensive installation guides for developers">
  <Header slot="header" currentPath="/holy-grail/" />

  <div data-pagefind-ignore="all">
    <HeroSection guideCount={allGuides.length} />
    <QuestSteps />
    <CategoriesGrid />
    <FeaturedGuides guides={featuredGuides} />
    <CTASection />
  </div>

  <Footer slot="footer" />
</BaseLayout>
