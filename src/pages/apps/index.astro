---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { sections } from '../../data/apps';
import { withBase } from '../../lib/paths';

const currentPath = withBase('apps/');

// Build headings for TableOfContents
const tocHeadings = [
  ...sections.map(s => ({ depth: 2, slug: s.id, text: s.title })),
  { depth: 2, slug: 'good-to-know', text: 'Good to Know' },
];

const uniqueAppNames = new Set<string>();
sections.forEach((section) => {
  section.groups?.forEach((group) => group.apps.forEach((app) => uniqueAppNames.add(app.name)));
  section.apps?.forEach((app) => uniqueAppNames.add(app.name));
});
const totalApps = uniqueAppNames.size;

function getDomain(href?: string): string {
  if (!href) return '';
  try { return new URL(href).hostname.replace('www.', ''); }
  catch { return ''; }
}

function faviconUrl(href?: string): string {
  const domain = getDomain(href);
  return domain ? `https://www.google.com/s2/favicons?domain=${domain}&sz=32` : '';
}
---

<BaseLayout title="Recommended Apps" description="A curated list of recommended macOS applications for developers">
  <Header slot="header" currentPath={currentPath} />

  <section class="apps-page" data-pagefind-body>
    <div class="container">

      <!-- ── Hero ──────────────────────────────────── -->
      <header class="hero">
        <div class="hero-ornament" aria-hidden="true">
          <span class="orn-line"></span>
          <span class="orn-diamond">◆</span>
          <span class="orn-line"></span>
        </div>
        <h1>Recommended Apps</h1>
        <p class="hero-sub">{totalApps} hand-picked macOS applications for developers &amp; power&nbsp;users</p>

        <!-- Search + Filters -->
        <div class="controls">
          <div class="search-box">
            <svg class="search-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
            <input type="text" id="app-search" placeholder="Search apps..." autocomplete="off" aria-label="Search apps" />
          </div>
          <div class="price-filters" role="group" aria-label="Filter by price">
            <button type="button" class="pf active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="pf" data-filter="free" aria-pressed="false"><span class="pf-dot free-dot"></span>Free</button>
            <button type="button" class="pf" data-filter="freemium" aria-pressed="false"><span class="pf-dot freemium-dot"></span>Freemium</button>
            <button type="button" class="pf" data-filter="paid" aria-pressed="false"><span class="pf-dot paid-dot"></span>Paid</button>
          </div>
          <div class="legend" aria-label="App marker legend">
            <span class="legend-item"><span class="legend-star" aria-hidden="true">⭐</span> Daily driver</span>
            <span class="legend-item"><span class="badge tag">AI</span> AI-assisted tool</span>
            <span class="legend-item"><span class="badge price">~$</span> Approximate price</span>
          </div>
        </div>
      </header>

      <!-- ── Two-column layout ─────────────────────── -->
      <div class="apps-layout">
        <div class="apps-main">

          <!-- Mobile TOC (hidden on desktop via component CSS) -->
          <div class="apps-toc-mobile">
            <TableOfContents headings={tocHeadings} />
          </div>

          <!-- No Results -->
          <div class="no-results" id="no-results" role="status" aria-live="polite" style="display:none;">
            <p>No apps match your search.</p>
          </div>

          <!-- Sections -->
        {sections.map((section) => (
          <section id={section.id} class="sect" data-sect>
            <div class="sect-head">
              <span class="sect-icon">{section.icon}</span>
              <div class="sect-titles">
                <h2>{section.title}</h2>
                {section.note && <p class="sect-note">{section.note}</p>}
              </div>
            </div>

            {section.groups ? (
              section.groups.map((group) => (
                <div class="grp" data-grp>
                  <h3 class="grp-label">{group.label}</h3>
                  <div class="cards">
                    {group.apps.map((app) => (
                      <article class:list={['card', { 'daily-driver': app.dailyDriver }]} data-name={app.name.toLowerCase()} data-desc={app.description.toLowerCase()} data-price={app.badgeType || 'none'}>
                        {app.dailyDriver && <span class="daily-star" aria-label="Daily driver">⭐</span>}
                        <div class="card-badges">
                          {app.badge && <span class={`badge ${app.badgeType || 'free'}`}>{app.badge}</span>}
                          {app.priceBadge && <span class="badge price">{app.priceBadge}</span>}
                          {app.tags?.map((tag) => <span class="badge tag">{tag}</span>)}
                        </div>
                        <div class="card-header">
                          <div class="card-fav-wrap">
                            {faviconUrl(app.href) ? (
                              <>
                                <img class="card-fav" src={faviconUrl(app.href)} alt="" width="20" height="20" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <span class="card-fav-fb" aria-hidden="true">{section.icon}</span>
                              </>
                            ) : (
                              <span class="card-fav-fb" style="display:flex" aria-hidden="true">{section.icon}</span>
                            )}
                          </div>
                          {app.href ? (
                            <a href={app.href} class="card-name" target="_blank" rel="noopener noreferrer">{app.name}<span class="ext" aria-hidden="true">&thinsp;↗</span></a>
                          ) : (
                            <span class="card-name">{app.name}</span>
                          )}
                        </div>
                        <p class="card-desc">{app.description}</p>
                      </article>
                    ))}
                  </div>
                </div>
              ))
            ) : section.apps ? (
              <div class="cards">
                {section.apps.map((app) => (
                  <article class:list={['card', { 'daily-driver': app.dailyDriver }]} data-name={app.name.toLowerCase()} data-desc={app.description.toLowerCase()} data-price={app.badgeType || 'none'}>
                    {app.dailyDriver && <span class="daily-star" aria-label="Daily driver">⭐</span>}
                    <div class="card-badges">
                      {app.badge && <span class={`badge ${app.badgeType || 'free'}`}>{app.badge}</span>}
                      {app.priceBadge && <span class="badge price">{app.priceBadge}</span>}
                      {app.tags?.map((tag) => <span class="badge tag">{tag}</span>)}
                    </div>
                    <div class="card-header">
                      <div class="card-fav-wrap">
                        {faviconUrl(app.href) ? (
                          <>
                            <img class="card-fav" src={faviconUrl(app.href)} alt="" width="20" height="20" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <span class="card-fav-fb" aria-hidden="true">{section.icon}</span>
                          </>
                        ) : (
                          <span class="card-fav-fb" style="display:flex" aria-hidden="true">{section.icon}</span>
                        )}
                      </div>
                      <div class="card-meta">
                        {app.href ? (
                          <a href={app.href} class="card-name" target="_blank" rel="noopener noreferrer">{app.name}<span class="ext" aria-hidden="true">&thinsp;↗</span></a>
                        ) : (
                          <span class="card-name">{app.name}</span>
                        )}
                      </div>
                    </div>
                    <p class="card-desc">{app.description}</p>
                  </article>
                ))}
              </div>
            ) : null}

            {section.tip && (
              <div class="sect-tip">
                <span class="tip-ico">{section.tipIcon || '💡'}</span>
                <p>{section.tip}</p>
              </div>
            )}
          </section>
        ))}

        <!-- Good to Know -->
        <section id="good-to-know" class="sect info-sect">
          <div class="sect-head">
            <span class="sect-icon">📋</span>
            <div class="sect-titles"><h2>Good to Know</h2></div>
          </div>

          <div class="info-row">
            <div class="info-card">
              <h3>⬇ Installing Apps</h3>
              <ul>
                <li><strong>Mac App Store</strong> — Sandboxed, auto-updates</li>
                <li><strong>Homebrew Cask</strong> — <code>brew install --cask &lt;app&gt;</code></li>
                <li><strong>Direct download</strong> — From the developer's website</li>
              </ul>
              <div class="brew-box">
                <code>brew install --cask raycast rectangle iterm2 visual-studio-code</code>
              </div>
            </div>
            <div class="info-card">
              <h3>🗑 Uninstalling Apps</h3>
              <p>
                Dragging an app to the Trash does not remove all its files.
                Use <a href="https://freemacsoft.net/appcleaner/">AppCleaner</a> to fully
                remove apps and their preferences, caches, and support&nbsp;files.
              </p>
            </div>
            <div class="info-card">
              <h3>📚 Resources</h3>
              <p>
                <a href="https://formulae.brew.sh/cask/">Homebrew Cask Formulae</a> — Search for
                macOS applications available through Homebrew&nbsp;Cask.
              </p>
            </div>
          </div>
        </section>

        </div>

        <!-- TOC sidebar (component renders both mobile + desktop) -->
        <aside class="apps-sidebar">
          <TableOfContents headings={tocHeadings} />
        </aside>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
  <BackToTop />
</BaseLayout>

<style>
  /* ═══════════════════════════════════════════════
     Recommended Apps — Editorial Catalog
     ═══════════════════════════════════════════════ */

  .apps-page {
    padding: var(--space-xl) 0 var(--space-4xl);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  /* ── Hero ─────────────────────────────────────── */
  .hero {
    text-align: center;
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .hero-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .orn-line {
    display: block;
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--grail-gold), transparent);
  }

  .orn-diamond {
    color: var(--grail-gold);
    font-size: 0.65rem;
    opacity: 0.7;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin-bottom: var(--space-sm);
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--turbo-text-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.6;
  }

  /* ── Controls ────────────────────────────────── */
  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    max-width: 480px;
    margin: 0 auto;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--turbo-text-secondary);
    opacity: 0.5;
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 10px 16px 10px 40px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--turbo-text-primary);
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-lg);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .search-box input:focus {
    border-color: var(--grail-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--grail-gold) 12%, transparent);
  }

  .search-box input::placeholder {
    color: var(--turbo-text-secondary);
    opacity: 0.5;
  }

  .price-filters {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pf {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--turbo-text-secondary);
    background: none;
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s;
  }

  .pf:hover {
    color: var(--turbo-text-primary);
    border-color: color-mix(in srgb, var(--grail-gold) 60%, transparent);
  }

  .pf.active {
    color: var(--grail-gold);
    border-color: var(--grail-gold);
    background: color-mix(in srgb, var(--grail-gold) 10%, transparent);
  }

  .pf-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .free-dot  { background: #a6e3a1; }
  .freemium-dot { background: #89b4fa; }
  .paid-dot  { background: var(--grail-gold); }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 12px;
    max-width: 560px;
    padding-top: 2px;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--turbo-text-secondary);
  }

  .legend-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--grail-gold) 16%, var(--turbo-bg-surface));
    border: 1px solid color-mix(in srgb, var(--grail-gold) 32%, transparent);
    font-size: 0.68rem;
    line-height: 1;
  }

  /* ── Two-column Layout ──────────────────────── */
  .apps-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 1200px) {
    .apps-layout {
      grid-template-columns: 1fr 250px;
    }
  }

  .apps-main {
    min-width: 0;
  }

  /* Mobile TOC wrapper: show on mobile, hide on desktop */
  .apps-toc-mobile {
    margin-bottom: var(--space-xl);
  }

  @media (min-width: 1200px) {
    .apps-toc-mobile {
      display: none;
    }
  }

  /* Desktop sidebar: hide on mobile, show on desktop */
  .apps-sidebar {
    display: none;
  }

  @media (min-width: 1200px) {
    .apps-sidebar {
      display: block;
    }
  }

  /* ── Sections ──────────────────────────────────── */
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .sect {
    scroll-margin-top: calc(70px + var(--space-lg));
    padding-top: var(--space-xl);
  }

  .sect-head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid color-mix(in srgb, var(--grail-gold) 20%, transparent);
  }

  .sect-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    font-size: 1.4rem;
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: 10px;
    flex-shrink: 0;
  }

  .sect-titles h2 {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .sect-titles h2::after { display: none; }

  .sect-note {
    margin: 4px 0 0;
    font-size: 0.88rem;
    color: var(--turbo-text-secondary);
    line-height: 1.4;
  }

  /* ── Groups ────────────────────────────────────── */
  .grp {
    margin-bottom: var(--space-xl);
  }

  .grp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--turbo-text-secondary);
    margin: 0 0 var(--space-sm) 2px;
    opacity: 0.7;
  }

  .grp-label::after { display: none; }

  /* ── Cards Grid ────────────────────────────────── */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
  }

  /* ── Card ──────────────────────────────────────── */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: 10px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--grail-gold) 45%, transparent);
    box-shadow: 0 2px 16px -2px color-mix(in srgb, var(--grail-gold) 8%, transparent);
    transform: translateY(-1px);
  }

  .card.hidden { display: none; }

  .card.daily-driver {
    border-color: color-mix(in srgb, var(--grail-gold) 38%, var(--turbo-border-default));
  }

  .daily-star {
    position: absolute;
    top: 8px;
    left: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--grail-gold) 16%, var(--turbo-bg-surface));
    border: 1px solid color-mix(in srgb, var(--grail-gold) 32%, transparent);
    font-size: 0.72rem;
    line-height: 1;
    box-shadow: 0 2px 8px -4px var(--grail-gold);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .card-fav-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--turbo-bg-overlay);
    border: 1px solid var(--turbo-border-default);
    border-radius: 7px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card:hover .card-fav-wrap {
    border-color: color-mix(in srgb, var(--grail-gold) 40%, transparent);
  }

  .card-fav {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .card-fav-fb {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 0.85rem;
  }

  .card-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--turbo-text-primary);
    text-decoration: none;
  }

  a.card-name:hover { color: var(--grail-gold); }
  a.card-name::after { display: none; }

  .ext {
    font-size: 0.7rem;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .card:hover .ext { opacity: 0.4; }

  .card-desc {
    margin: 0;
    font-size: 0.82rem;
    color: var(--turbo-text-secondary);
    line-height: 1.4;
  }

  /* ── Badges ────────────────────────────────────── */
  .badge {
    display: inline-block;
    padding: 1px 9px;
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.6;
  }

  .card-badges {
    display: flex;
    gap: 4px;
    align-items: center;
    justify-content: flex-end;
    min-height: 20px;
  }

  .badge.free {
    background: color-mix(in srgb, #a6e3a1 14%, transparent);
    color: #a6e3a1;
    border: 1px solid color-mix(in srgb, #a6e3a1 28%, transparent);
  }

  .badge.freemium {
    background: color-mix(in srgb, #89b4fa 14%, transparent);
    color: #89b4fa;
    border: 1px solid color-mix(in srgb, #89b4fa 28%, transparent);
  }

  .badge.paid {
    background: color-mix(in srgb, var(--grail-gold) 14%, transparent);
    color: var(--grail-gold);
    border: 1px solid color-mix(in srgb, var(--grail-gold) 28%, transparent);
  }

  .badge.price {
    background: color-mix(in srgb, #cba6f7 14%, transparent);
    color: #cba6f7;
    border: 1px solid color-mix(in srgb, #cba6f7 28%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .badge.tag {
    background: color-mix(in srgb, #f38ba8 14%, transparent);
    color: #f38ba8;
    border: 1px solid color-mix(in srgb, #f38ba8 28%, transparent);
  }

  /* ── Tip ───────────────────────────────────────── */
  .sect-tip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: var(--space-lg);
    padding: 12px 16px;
    background: color-mix(in srgb, var(--grail-gold) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--grail-gold) 16%, transparent);
    border-left: 3px solid color-mix(in srgb, var(--grail-gold) 50%, transparent);
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .tip-ico { flex-shrink: 0; line-height: 1.5; }

  .sect-tip p {
    margin: 0;
    color: var(--turbo-text-secondary);
    line-height: 1.5;
  }

  /* ── No Results ────────────────────────────────── */
  .no-results {
    text-align: center;
    padding: var(--space-3xl) 0;
  }

  .no-results p {
    font-family: var(--font-display);
    color: var(--turbo-text-secondary);
    font-size: 1rem;
  }

  /* ── Info Cards ────────────────────────────────── */
  .info-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }

  .info-card {
    padding: var(--space-lg);
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: 10px;
    border-top: 2px solid color-mix(in srgb, var(--grail-gold) 35%, transparent);
  }

  .info-card h3 {
    font-size: 0.95rem;
    margin: 0 0 var(--space-sm);
  }

  .info-card h3::after { display: none; }

  .info-card p,
  .info-card li {
    font-size: 0.88rem;
    color: var(--turbo-text-secondary);
    line-height: 1.5;
  }

  .info-card p { margin: 0 0 var(--space-sm); }
  .info-card p:last-child { margin-bottom: 0; }

  .info-card ul {
    margin: 0 0 var(--space-sm);
    padding-left: var(--space-lg);
  }

  .info-card li { margin-bottom: 4px; }

  .brew-box {
    padding: 8px 12px;
    background: var(--turbo-bg-overlay);
    border-radius: 6px;
    overflow-x: auto;
  }

  .brew-box code {
    font-size: 0.78rem;
    background: none;
    border: none;
    padding: 0;
    white-space: nowrap;
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 480px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 var(--space-md);
    }

    .hero {
      padding: var(--space-lg) 0 var(--space-md);
    }
  }
</style>

<script>
  function initAppsFilter() {
    const input = document.getElementById('app-search') as HTMLInputElement | null;
    if (!input || input.dataset.bound === 'true') return;

    const pills = document.querySelectorAll<HTMLButtonElement>('.pf[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.card[data-name]');
    const sects = document.querySelectorAll<HTMLElement>('[data-sect]');
    const grps = document.querySelectorAll<HTMLElement>('[data-grp]');
    const noRes = document.getElementById('no-results');

    let filter = 'all';
    let query = '';

    function run() {
      let total = 0;
      cards.forEach(c => {
        const matchQ = !query || (c.dataset.name || '').includes(query) || (c.dataset.desc || '').includes(query);
        const matchF = filter === 'all' || (c.dataset.price || '') === filter;
        const show = matchQ && matchF;
        c.classList.toggle('hidden', !show);
        if (show) total++;
      });

      sects.forEach(s => {
        if (s.classList.contains('info-sect')) return;
        const vis = s.querySelectorAll('.card:not(.hidden)').length > 0;
        s.style.display = vis ? '' : 'none';
      });

      grps.forEach(g => {
        const vis = g.querySelectorAll('.card:not(.hidden)').length > 0;
        g.style.display = vis ? '' : 'none';
      });

      if (noRes) noRes.style.display = total > 0 ? 'none' : '';
    }

    input.addEventListener('input', () => { query = input.value.toLowerCase().trim(); run(); });

    pills.forEach(p => p.addEventListener('click', () => {
      pills.forEach(x => {
        x.classList.remove('active');
        x.setAttribute('aria-pressed', 'false');
      });
      p.classList.add('active');
      p.setAttribute('aria-pressed', 'true');
      filter = p.dataset.filter || 'all';
      run();
    }));

    input.dataset.bound = 'true';
  }

  initAppsFilter();
  document.addEventListener('astro:after-swap', initAppsFilter);
</script>
