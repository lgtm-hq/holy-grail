---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getAllCategories } from '../../lib/categories';
import { withBase } from '../../lib/paths';

// Guide data shape for standalone type checking
interface GuideData {
  category: string;
}

const allGuides = await getCollection('guides');
const base = withBase;

// Get categories from centralized config
const categories = getAllCategories().filter(c => c.slug !== 'tools');

// Count guides per category
const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: allGuides.filter((g) => (g.data as GuideData).category.toLowerCase() === cat.slug).length,
}));
---

<BaseLayout title="Categories" description="Browse guides by category">
  <Header slot="header" currentPath={base('categories/')} />

  <section class="categories-page" data-pagefind-ignore="all">
    <div class="container">
      <div class="page-header">
        <h1>⚔️ Choose Your Quest</h1>
        <p class="page-description">
          Each category represents a different path on your journey to developer mastery.
          <br />
          Select a realm to explore its guides.
        </p>
      </div>

      <div class="categories-grid">
        {categoryCounts.map((category) => (
          <a
            href={base(`categories/${category.slug}/`)}
            class={`category-card category-${category.slug}`}
            style={`--category-accent: ${category.color}`}
          >
            <div class="card-glow" aria-hidden="true"></div>

            <div class="card-header">
              <div class="category-icon">{category.icon}</div>
              <span class="guide-count">{category.count} guide{category.count !== 1 ? 's' : ''}</span>
            </div>

            <h2 class="category-name">{category.name}</h2>
            <p class="category-description">{category.description}</p>

            <div class="card-footer">
              <span class="explore-link">
                Explore {category.name}
                <span class="arrow">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .categories-page {
    padding: var(--space-3xl) 0;
    min-height: 60vh;
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .page-header h1 {
    margin-bottom: var(--space-md);
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--turbo-text-secondary);
    max-width: 500px;
    margin: 0 auto;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }

  .category-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-2xl);
    background: var(--turbo-bg-surface);
    border: 2px solid var(--turbo-border-default);
    border-radius: var(--radius-xl);
    text-decoration: none;
    color: var(--turbo-text-primary);
    position: relative;
    overflow: hidden;
    transition: all var(--transition-normal);
  }

  .category-card::after {
    display: none;
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 150px;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--category-accent) 15%, transparent) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .category-card:hover {
    border-color: var(--category-accent);
    transform: translateY(-8px);
    box-shadow: 0 25px 50px color-mix(in srgb, var(--category-accent) 15%, transparent);
  }

  .category-card:hover .card-glow {
    opacity: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .category-icon {
    font-size: 3.5rem;
    transition: transform var(--transition-normal);
  }

  .category-card:hover .category-icon {
    transform: scale(1.15) rotate(-8deg);
  }

  .guide-count {
    padding: var(--space-xs) var(--space-sm);
    background: var(--turbo-bg-overlay);
    border-radius: var(--radius-full);
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--turbo-text-secondary);
  }

  .category-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-sm);
    color: var(--category-accent);
    position: relative;
    z-index: 1;
  }

  .category-description {
    font-size: 1rem;
    color: var(--turbo-text-secondary);
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .card-footer {
    position: relative;
    z-index: 1;
  }

  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--turbo-text-secondary);
    transition: color var(--transition-fast);
  }

  .category-card:hover .explore-link {
    color: var(--category-accent);
  }

  .arrow {
    transition: transform var(--transition-fast);
  }

  .category-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
