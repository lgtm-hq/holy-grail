---
/**
 * FeaturedGuides - Grid of featured guide cards for homepage
 */
import GuideCard from '../GuideCard.astro';
import { withBase } from '../../lib/paths';
import type { CollectionEntry } from 'astro:content';

// Guide data shape for standalone type checking
interface GuideData {
  title: string;
  description: string;
  category: string;
  order?: number;
  tags?: string[];
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
}

interface Props {
  guides: CollectionEntry<'guides'>[];
}

const { guides = [] } = Astro.props as Props;
const base = withBase;
---

<section class="featured-section">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">Featured Guides</h2>
        <p class="section-subtitle">Start with these essential quests</p>
      </div>
      <a href={base('guides/')} class="view-all-link">
        View all guides →
      </a>
    </div>

    {guides.length > 0 ? (
      <div class="guides-grid">
        {guides.map((guide) => {
          const guideData = guide.data as GuideData;
          return (
            <GuideCard
              title={guideData.title}
              description={guideData.description}
              href={base(`guides/${guide.id}/`)}
              category={guideData.category}
              tags={guideData.tags}
              order={guideData.order}
              slug={guide.id}
              difficulty={guideData.difficulty}
            />
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p>Guides are being prepared. Check back soon!</p>
        <a href={base('guides/')} class="empty-cta">Browse all guides →</a>
      </div>
    )}
  </div>
</section>

<style>
  .featured-section {
    padding: var(--space-4xl) 0;
    background: var(--turbo-bg-surface);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .section-title {
    text-align: left;
    margin-bottom: 0;
  }

  .section-subtitle {
    text-align: left;
    color: var(--turbo-text-secondary);
    font-size: 1.1rem;
    margin-top: var(--space-xs);
    margin-bottom: 0;
  }

  .view-all-link {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--grail-gold);
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-2xl);
    background: var(--turbo-bg-muted);
    border: 1px dashed var(--turbo-border-default);
    border-radius: var(--radius-md);
  }

  .empty-state p {
    color: var(--turbo-text-secondary);
    margin-bottom: var(--space-md);
  }

  .empty-cta {
    font-family: var(--font-display);
    color: var(--grail-gold);
  }
</style>
