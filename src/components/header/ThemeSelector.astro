---
/**
 * ThemeSelector - Shell for turbo-themes' wireFlavorSelector
 *
 * Provides the minimal DOM structure that the turbo-themes selector
 * needs to build its dropdown UI programmatically.
 */
---

<div class="navbar-item has-dropdown theme-selector-wrapper" id="theme-dropdown">
  <button
    id="theme-flavor-trigger"
    class="theme-trigger"
    type="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Theme selector"
  >
    <img id="theme-flavor-trigger-icon" src="" alt="" width="24" height="24" />
    <span class="trigger-label" id="theme-trigger-label">Theme</span>
  </button>
  <div id="theme-flavor-menu" class="theme-menu" role="menu"></div>
  <select id="theme-flavor-select" style="display:none" aria-hidden="true"></select>
</div>

<style>
  /* Wrapper - the selector requires .navbar-item.has-dropdown as an ancestor */
  .theme-selector-wrapper {
    position: relative;
  }

  /* Trigger button */
  .theme-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-md);
    color: var(--turbo-text-secondary);
    font-family: var(--font-body);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .theme-trigger:hover,
  .theme-trigger:focus-visible {
    border-color: var(--grail-gold);
    color: var(--turbo-text-primary);
  }

  .theme-trigger:focus-visible {
    outline: 2px solid var(--grail-gold);
    outline-offset: 2px;
  }

  .theme-trigger img {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    object-fit: contain;
  }

  .trigger-label {
    display: none;
  }

  @media (min-width: 640px) {
    .trigger-label {
      display: inline;
    }
  }

  .theme-trigger.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  /* Dropdown menu */
  .theme-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 260px;
    max-height: 420px;
    overflow-y: auto;
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.3);
    z-index: 200;
    padding: var(--space-xs) 0;
    display: none;
  }

  /* turbo-themes toggles is-active on the wrapper, not the menu */
  .theme-selector-wrapper:global(.is-active) .theme-menu {
    display: block;
    animation: theme-menu-enter 0.15s ease-out;
  }

  @keyframes theme-menu-enter {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Family groups - populated by wireFlavorSelector */
  .theme-menu :global(.theme-family-group) {
    animation: theme-group-enter 0.2s ease-out backwards;
    animation-delay: var(--animation-delay, 0ms);
  }

  .theme-menu :global(.theme-family-group + .theme-family-group) {
    border-top: 1px solid var(--turbo-border-default);
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
  }

  @keyframes theme-group-enter {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .theme-menu :global(.theme-family-header) {
    padding: var(--space-xs) var(--space-md);
  }

  .theme-menu :global(.theme-family-name) {
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--turbo-text-secondary);
  }

  /* Theme items */
  .theme-menu :global(.dropdown-item.theme-item) {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    padding: 6px var(--space-md);
    background: none;
    border: none;
    color: var(--turbo-text-primary);
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    transition: background var(--transition-fast);
    text-align: left;
  }

  .theme-menu :global(.dropdown-item.theme-item:hover),
  .theme-menu :global(.dropdown-item.theme-item:focus-visible) {
    background: var(--turbo-bg-overlay);
  }

  .theme-menu :global(.dropdown-item.theme-item:focus-visible) {
    outline: none;
    box-shadow: inset 2px 0 0 var(--grail-gold);
  }

  .theme-menu :global(.dropdown-item.theme-item.is-active) {
    background: color-mix(in srgb, var(--grail-gold) 12%, transparent);
    color: var(--grail-gold);
  }

  /* Theme icon */
  .theme-menu :global(.theme-icon) {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .theme-menu :global(.theme-icon-placeholder) {
    display: inline-block;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: var(--turbo-bg-overlay);
    flex-shrink: 0;
  }

  /* Theme text */
  .theme-menu :global(.theme-copy) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .theme-menu :global(.theme-title) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.85rem;
  }

  .theme-menu :global(.theme-description) {
    display: none;
  }

  /* Checkmark */
  .theme-menu :global(.theme-check) {
    flex-shrink: 0;
    opacity: 0;
    color: var(--grail-gold);
    transition: opacity var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .theme-menu :global(.dropdown-item.theme-item.is-active .theme-check) {
    opacity: 1;
  }
</style>
