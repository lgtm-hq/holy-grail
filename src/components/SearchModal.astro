---
/**
 * SearchModal - Search overlay triggered by Cmd+K / Ctrl+K
 *
 * Uses Pagefind for search functionality
 */
---

<div id="search-modal" class="search-modal" hidden aria-hidden="true">
  <div class="search-backdrop" data-close-modal></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="Search guides">
    <div class="search-header">
      <span class="search-label">Search guides</span>
      <div class="search-shortcuts">
        <kbd>Esc</kbd>
        <span>to close</span>
      </div>
    </div>
    <div id="search-modal-container"></div>
  </div>
</div>

<script>
  import { loadPagefind } from '../lib/pagefindLoader';

  let searchInitialized = false;

  function openSearchModal() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;

    modal.removeAttribute('hidden');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    initModalSearch();

    // Focus search input after short delay
    setTimeout(() => {
      const input = modal.querySelector('.pagefind-ui__search-input') as HTMLInputElement;
      if (input) input.focus();
    }, 100);
  }

  function closeSearchModal() {
    const modal = document.getElementById('search-modal');
    if (!modal) return;

    modal.setAttribute('hidden', '');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function addCustomClearButton() {
    const form = document.querySelector('#search-modal-container .pagefind-ui__form');
    const input = document.querySelector(
      '#search-modal-container .pagefind-ui__search-input',
    ) as HTMLInputElement;
    if (!form || !input || document.getElementById('custom-clear-btn')) return;

    const clearBtn = document.createElement('button');
    clearBtn.id = 'custom-clear-btn';
    clearBtn.type = 'button';
    clearBtn.className = 'custom-clear-button';
    clearBtn.setAttribute('aria-label', 'Clear search');
    clearBtn.innerHTML = '⚔️';
    clearBtn.style.display = input.value ? 'flex' : 'none';

    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
      clearBtn.style.display = 'none';
    });

    input.addEventListener('input', () => {
      clearBtn.style.display = input.value ? 'flex' : 'none';
    });

    form.appendChild(clearBtn);
  }

  async function initModalSearch() {
    const container = document.getElementById('search-modal-container');
    if (!container || searchInitialized) return;

    const success = await loadPagefind('search-modal-container', (message) => {
      container.innerHTML = `<p class="search-unavailable">${message}</p>`;
    });

    if (success) {
      searchInitialized = true;
      setTimeout(addCustomClearButton, 100);
    }
  }

  // Keyboard shortcut handler
  document.addEventListener('keydown', (e) => {
    // Cmd+K (Mac) or Ctrl+K (Windows/Linux)
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearchModal();
    }

    // ESC to close
    if (e.key === 'Escape') {
      closeSearchModal();
    }
  });

  // Click backdrop to close
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target?.hasAttribute?.('data-close-modal')) {
      closeSearchModal();
    }
  });

  // Allow opening search modal from search trigger button
  function initSearchTriggers() {
    const triggers = document.querySelectorAll('[data-search-trigger]');
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openSearchModal();
      });
    });
  }

  initSearchTriggers();
  document.addEventListener('astro:after-swap', () => {
    searchInitialized = false;
    initSearchTriggers();
  });
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    /* 10vh from top positions dialog in comfortable reading zone */
    padding-top: 10vh;
  }

  .search-modal[hidden] {
    display: none;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--turbo-bg-base) 80%, transparent);
    backdrop-filter: blur(4px);
  }

  .search-dialog {
    position: relative;
    width: 90%;
    /* 600px max keeps content scannable; standard modal width */
    max-width: 600px;
    /* 70vh allows results list while leaving room for header */
    max-height: 70vh;
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-lg);
    /* Elevated shadow creates depth for modal overlay */
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--turbo-border-default);
    background: var(--turbo-bg-muted);
  }

  .search-label {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--turbo-text-primary);
  }

  .search-shortcuts {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--turbo-text-secondary);
    font-size: 0.8rem;
  }

  .search-shortcuts kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding: 2px 6px;
    background: var(--turbo-bg-base);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--turbo-text-secondary);
  }

  #search-modal-container {
    padding: var(--space-md);
    overflow-y: auto;
    flex: 1;
  }

  /* Pagefind UI theme variables */
  #search-modal-container :global(.pagefind-ui) {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--grail-gold);
    --pagefind-ui-text: var(--turbo-text-primary);
    --pagefind-ui-background: var(--turbo-bg-base);
    --pagefind-ui-border: var(--turbo-border-default);
    --pagefind-ui-tag: var(--turbo-bg-overlay);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-body);
  }

  /* Pagefind UI overrides for modal */
  #search-modal-container :global(.pagefind-ui__search-input) {
    background: var(--turbo-bg-base);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-md);
    color: var(--turbo-text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: var(--space-sm) var(--space-md);
    width: 100%;
  }

  #search-modal-container :global(.pagefind-ui__search-input:focus) {
    outline: 2px solid var(--grail-gold);
    outline-offset: 2px;
    border-color: var(--grail-gold);
  }

  /* Search form wrapper - position relative for clear button */
  #search-modal-container :global(.pagefind-ui__form) {
    position: relative;
  }

  /* Hide the default search icon */
  #search-modal-container :global(.pagefind-ui__form::before) {
    display: none !important;
  }

  /* Hide the default Pagefind clear button */
  #search-modal-container :global(.pagefind-ui__search-clear) {
    display: none !important;
  }

  /* Fix input padding so text doesn't overlap where icon was */
  #search-modal-container :global(.pagefind-ui__search-input) {
    padding-left: var(--space-md) !important;
    padding-right: 48px !important;
  }

  /* Custom clear button - crossed swords */
  #search-modal-container :global(.custom-clear-button) {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--turbo-text-secondary);
    font-size: 1.2rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s ease;
    padding: 0;
    z-index: 10;
  }

  #search-modal-container :global(.custom-clear-button:hover) {
    transform: translateY(-50%) scale(1.15);
  }

  #search-modal-container :global(.pagefind-ui__result) {
    padding: var(--space-md);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-sm);
    background: var(--turbo-bg-muted);
    transition: all 0.2s ease;
  }

  #search-modal-container :global(.pagefind-ui__result:hover) {
    border-color: var(--grail-gold);
    background: var(--turbo-bg-surface);
  }

  #search-modal-container :global(.pagefind-ui__result-link) {
    color: var(--grail-gold);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
  }

  #search-modal-container :global(.pagefind-ui__result-excerpt) {
    color: var(--turbo-text-secondary);
    font-size: 0.9rem;
    margin-top: var(--space-xs);
  }

  #search-modal-container :global(mark) {
    background: color-mix(in srgb, var(--grail-gold) 30%, transparent);
    color: var(--turbo-text-primary);
    padding: 0 2px;
    border-radius: 2px;
  }

  .search-unavailable {
    text-align: center;
    color: var(--turbo-text-secondary);
    padding: var(--space-xl);
  }
</style>
