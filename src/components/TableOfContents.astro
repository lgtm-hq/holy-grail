---
/**
 * TableOfContents - Auto-generated table of contents from page headings
 *
 * Includes both:
 * - Mobile TOC: Collapsible at top of content (< 1200px)
 * - Desktop TOC: Sticky sidebar (>= 1200px)
 *
 * Usage in guide pages:
 *   <TableOfContents headings={headings} />
 *
 * Where headings comes from Astro's render() function
 */

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = 'On This Page' } = Astro.props;

// Filter to only h2 and h3 headings
const filteredHeadings = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <>
    {/* Mobile TOC - Collapsible at top of content */}
    <details class="toc-mobile">
      <summary class="toc-mobile-trigger">
        <span class="toc-mobile-title">{title}</span>
        <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>
      <nav class="toc-mobile-content" aria-label="Table of contents">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} class="toc-link" data-toc-mobile-link>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    {/* Desktop TOC - Sticky sidebar */}
    <nav class="toc toc-desktop" aria-label="Table of contents">
      <h2 class="toc-title">{title}</h2>
      <ul class="toc-list">
        {filteredHeadings.map((heading) => (
          <li class={`toc-item depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}

<script>
  // Store observer reference for cleanup
  declare global {
    interface Window {
      __tocObserver?: IntersectionObserver;
    }
  }

  function initToc() {
    // Handle both desktop and mobile TOC
    const tocContainers = document.querySelectorAll('.toc-desktop, .toc-mobile-content');
    if (tocContainers.length === 0) return;

    const allLinks = document.querySelectorAll('.toc-link');
    const headings = Array.from(allLinks)
      .filter(link => link.closest('.toc-desktop'))
      .map(link => {
        const id = link.getAttribute('href')?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter(Boolean) as HTMLElement[];

    if (headings.length === 0) return;

    // Disconnect previous observer if it exists
    if (window.__tocObserver) {
      window.__tocObserver.disconnect();
    }

    const desktopToc = document.querySelector('.toc-desktop');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            allLinks.forEach((link) => {
              const href = link.getAttribute('href');
              if (href === `#${id}`) {
                link.classList.add('active');
                // Scroll the desktop TOC to keep the active item visible
                if (desktopToc?.contains(link)) {
                  link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
              } else {
                link.classList.remove('active');
              }
            });
          }
        });
      },
      {
        rootMargin: '-80px 0px -80% 0px',
        threshold: 0,
      }
    );

    // Store observer reference for cleanup
    window.__tocObserver = observer;

    headings.forEach((heading) => observer.observe(heading));

    // Close mobile TOC when clicking a link
    const mobileToc = document.querySelector('.toc-mobile');
    const mobileLinks = document.querySelectorAll('[data-toc-mobile-link]');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (mobileToc) {
          mobileToc.removeAttribute('open');
        }
      });
    });
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initToc);

  // Re-initialize after Astro page transitions
  document.addEventListener('astro:after-swap', initToc);
</script>

<style>
  /* ==================== Mobile TOC ==================== */
  .toc-mobile {
    display: block;
    margin-bottom: var(--space-xl);
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-md);
  }

  @media (min-width: 1200px) {
    .toc-mobile {
      display: none;
    }
  }

  .toc-mobile-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .toc-mobile-trigger::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--turbo-text-primary);
  }

  .toc-chevron {
    color: var(--turbo-text-secondary);
    transition: transform var(--transition-fast);
  }

  .toc-mobile[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-mobile-content {
    padding: 0 var(--space-md) var(--space-md);
    border-top: 1px solid var(--turbo-border-default);
  }

  /* ==================== Desktop TOC ==================== */
  .toc-desktop {
    display: none;
  }

  @media (min-width: 1200px) {
    .toc-desktop {
      display: block;
      position: sticky;
      top: 100px;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      padding: var(--space-md);
      background: var(--turbo-bg-surface);
      border: 1px solid var(--turbo-border-default);
      border-radius: var(--radius-md);
      font-size: 0.875rem;
    }
  }

  .toc-title {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--turbo-text-secondary);
    margin: 0 0 var(--space-md) 0;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--turbo-border-default);
  }

  /* ==================== Shared TOC Styles ==================== */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-item.depth-3 {
    padding-left: var(--space-md);
  }

  .toc-link {
    display: block;
    padding: var(--space-xs) 0;
    color: var(--turbo-text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: var(--space-sm);
    margin-left: calc(-1 * var(--space-sm) - 2px);
    transition: all 0.15s ease;
    font-size: 0.875rem;
  }

  .toc-link:hover {
    color: var(--turbo-text-primary);
    border-left-color: var(--turbo-text-secondary);
    background: color-mix(in srgb, var(--turbo-bg-overlay) 50%, transparent);
    padding-left: var(--space-md);
  }

  .toc-link.active {
    color: var(--grail-gold);
    border-left-color: var(--grail-gold);
  }

  .toc-link::after {
    display: none;
  }
</style>
