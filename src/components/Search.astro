---
/**
 * Search - Pagefind-powered search component
 *
 * Pagefind indexes the site at build time.
 * Run `bun run build` to generate the search index.
 */
---

<div id="search" class="search-container"></div>

<script>
  async function initSearch() {
    const searchContainer = document.getElementById('search');
    if (!searchContainer) return;

    try {
      // Dynamically import Pagefind UI
      // @ts-ignore - Pagefind is generated at build time
      const { PagefindUI } = await import('@pagefind/default-ui');

      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        excerptLength: 15,
        resetStyles: true,
      });
    } catch (error) {
      // Pagefind UI may not be available in development or if build failed
      console.warn('Pagefind UI not available:', error);
    }
  }

  // Initialize on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSearch);
  } else {
    initSearch();
  }
</script>

<style is:global>
  .search-container {
    width: 100%;
    max-width: 400px;
  }

  /* Pagefind UI Customization */
  :root {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--grail-gold);
    --pagefind-ui-text: var(--turbo-text-primary);
    --pagefind-ui-background: var(--turbo-bg-surface);
    --pagefind-ui-border: var(--turbo-border-default);
    --pagefind-ui-tag: var(--turbo-bg-overlay);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-md);
    --pagefind-ui-font: var(--font-body);
  }

  .pagefind-ui__search-input {
    background: var(--turbo-bg-surface) !important;
    border: 1px solid var(--turbo-border-default) !important;
    color: var(--turbo-text-primary) !important;
    border-radius: var(--radius-md) !important;
    font-family: var(--font-body) !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--grail-gold) !important;
    outline: none !important;
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--grail-gold) 30%, transparent) !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: var(--turbo-text-secondary) !important;
  }

  .pagefind-ui__result {
    background: var(--turbo-bg-surface) !important;
    border: 1px solid var(--turbo-border-default) !important;
    border-radius: var(--radius-md) !important;
    padding: var(--space-md) !important;
  }

  .pagefind-ui__result:hover {
    border-color: var(--grail-gold) !important;
  }

  .pagefind-ui__result-link {
    color: var(--turbo-text-primary) !important;
    font-family: var(--font-display) !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--turbo-text-secondary) !important;
  }

  .pagefind-ui__result-title {
    font-weight: 600 !important;
  }

  .pagefind-ui__button {
    background: var(--grail-gold) !important;
    color: var(--turbo-bg-base) !important;
    border-radius: var(--radius-md) !important;
  }

  .pagefind-ui__message {
    color: var(--turbo-text-secondary) !important;
  }

  /* Search trigger button for header */
  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-md);
    background: var(--turbo-bg-surface);
    border: 1px solid var(--turbo-border-default);
    border-radius: var(--radius-md);
    color: var(--turbo-text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .search-trigger:hover {
    border-color: var(--grail-gold);
    color: var(--turbo-text-primary);
  }

  .search-trigger kbd {
    font-size: 0.75rem;
    padding: 2px 6px;
    background: var(--turbo-bg-overlay);
    border-radius: var(--radius-sm);
  }
</style>
